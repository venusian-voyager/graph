{
    "name": "venusian-voyager/graph",
    "description": "Neo4j graph driver and Instrument models for Venusian (companion to voyager/database).",
    "license": "MIT",
    "version": "0.9.0",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5",
        "venusian-voyager/contracts": "^0.9.0",
        "venusian-voyager/database": "^0.9.0",
        "venusian-voyager/nuts-and-bolts": "^0.9.0"
    },
    "suggest": {
        "laudis/neo4j-php-client": "Required to open Neo4j connections via Neo4jConnector (^3.3).",
        "venusian-voyager/console": "Required to use the make:graph-model command (^0.9.0)."
    },
    "autoload": {
        "psr-4": {
            "Voyager\\Graph\\": ""
        },
        "files": [
            "Helpers/functions.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.9.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev"
}
